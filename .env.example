# ==========================================
# RentCar - Email & Server Environment Config
# ==========================================

# Server Port (for standalone Express server)
PORT=5000

# Nodemailer SMTP Configuration
# For Gmail: Use smtp.gmail.com, port 587 (secure=false with STARTTLS), and generate a 16-character App Password.
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Email Sender Information
SMTP_FROM="CARRENT Official" <no-reply@carrent.com>

# Promo Code Configuration
PROMO_CODE=Niazi804
DISCOUNT_PERCENT=10

